 	 * compression type for CSTP and DTLS. Although all we've seen
diff --git a/openssl.c b/openssl.c
index 761cb03..c26b8f3 100644
--- a/openssl.c
+++ b/openssl.c
@@ -2440,6 +2440,9 @@ void append_strap_privkey(struct openconnect_info *vpninfo,
 	int derlen = i2d_ECPrivateKey(vpninfo->strap_key, &der);
 	if (derlen > 0)
 		buf_append_base64(buf, der, derlen, 0);
+	/* A private key: wipe it, and don't leak it on every reconnect. */
+	if (der)
+		OPENSSL_clear_free(der, derlen > 0 ? derlen : 0);
 }
 
